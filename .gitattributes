# Auto-detect text files and normalize line endings to LF in the repo
* text=auto

# Force LF for source code
*.cs text eol=lf
*.xaml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.sln text eol=lf
*.csproj text eol=lf
*.config text eol=lf
*.settings text eol=lf

# Binary files - no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.xls binary
*.dll binary
*.exe binary
