<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================
         BOUTONS « APOTHECARY LEDGER »
         - Coins quasi-droits (2px), pas d'ombre
         - Hairline encrée + remplissage botanique
         - Texte en sans-sérif, légèrement plus serré
         - Petites majuscules tipographiques sur les CTA
         Toutes les anciennes clés sont conservées pour
         compatibilité avec les vues existantes.
    ============================================ -->

    <!-- ── Base : pas d'ombre, transitions encrées ── -->
    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="presenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Primaire : encre botanique solide ── -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource BotanicalBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BotanicalDarkBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BotanicalDarkBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Secondaire : ocre, signature éditoriale ── -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource OchreBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OchreDarkBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource BoneBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource OchreDarkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Succès : vert mousse ── -->
    <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource MossBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MossDarkBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource BoneBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource MossDarkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Danger : vermillon, réservé aux suppressions / annulations critiques ── -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource VermillionBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource VermillionDarkBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource BoneBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource VermillionDarkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Avertissement : ocre clair, ink ── -->
    <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource OchreLightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OchreBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OchreDarkBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource OchreBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource BoneBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Outline / ghost : fond bone, contour encre ── -->
    <Style x:Key="OutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource BoneBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource BoneBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Bouton icône (carré encre, hairline) ── -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource BoneBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource BotanicalLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── FAB : carré botanique posé, plutôt qu'un blob orange ── -->
    <Style x:Key="FloatingActionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="Background" Value="{DynamicResource BotanicalBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource BoneBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource BotanicalDarkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================
         OVERRIDES MATERIAL DESIGN
         Les boutons des dialogues d'ajout/édition utilisent
         MaterialDesignRaisedButton / MaterialDesignFlatButton /
         MaterialDesignOutlinedButton — on retire les ombres
         et on aligne sur la palette « Apothecary ».
    ============================================ -->

    <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}"/>

    <!-- Raised : encre botanique, plat -->
    <Style x:Key="MaterialDesignRaisedButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"/>
    <Style x:Key="MaterialDesignRaisedLightButton" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}"/>
    <Style x:Key="MaterialDesignRaisedDarkButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"/>
    <Style x:Key="MaterialDesignRaisedAccentButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"/>
    <Style x:Key="MaterialDesignRaisedSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"/>

    <!-- Flat : transparent, encre -->
    <Style x:Key="MaterialDesignFlatButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource BotanicalDarkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource BotanicalLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MaterialDesignFlatLightButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}"/>
    <Style x:Key="MaterialDesignFlatDarkButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}"/>
    <Style x:Key="MaterialDesignFlatAccentButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="Foreground" Value="{DynamicResource OchreDarkBrush}"/>
    </Style>

    <!-- Outlined : encre sur bone -->
    <Style x:Key="MaterialDesignOutlinedButton" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}"/>

    <!-- Outlined ToggleButton : équivalent visuel pour les ToggleButton (MD v5
         ne fournit pas de MaterialDesignOutlinedToggleButton). Utilisé pour
         les filtres avec un état "checked" subtilement coloré. -->
    <Style x:Key="OutlinedToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaterialDesignSelection}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon / FAB Material -->
    <Style x:Key="MaterialDesignIconButton" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style x:Key="MaterialDesignIconForegroundButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}"/>

    <Style x:Key="MaterialDesignFloatingActionButton" TargetType="Button" BasedOn="{StaticResource FloatingActionButtonStyle}"/>
    <Style x:Key="MaterialDesignFloatingActionMiniButton" TargetType="Button" BasedOn="{StaticResource FloatingActionButtonStyle}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
    </Style>
    <Style x:Key="MaterialDesignFloatingActionAccentButton" TargetType="Button" BasedOn="{StaticResource FloatingActionButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource OchreBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OchreDarkBrush}"/>
    </Style>

    <!-- ============================================
         TAB PAGES (Bibliothèque / Base de données)
    ============================================ -->

    <Style x:Key="TabToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="136"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="TabToolbarSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="TabToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="TabDialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Height" Value="38"/>
        <Setter Property="MinWidth" Value="124"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="TabDialogSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
        <Setter Property="Height" Value="38"/>
        <Setter Property="MinWidth" Value="102"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

</ResourceDictionary>
