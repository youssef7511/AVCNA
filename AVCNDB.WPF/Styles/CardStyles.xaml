<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================
         CARTES « APOTHECARY LEDGER »
         Pas d'ombres lourdes : surfaces définies par
         le contraste Bone/Paper et un trait fin Ink.
    ============================================ -->

    <!-- Carte de base -->
    <Style x:Key="BaseCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BoneBrush}"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- Carte « élevée » : trait plus encré, sans ombre -->
    <Style x:Key="ElevatedCardStyle" TargetType="Border" BasedOn="{StaticResource BaseCardStyle}">
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- Carte avec bordure (alias pour rétro-compatibilité) -->
    <Style x:Key="OutlinedCardStyle" TargetType="Border" BasedOn="{StaticResource BaseCardStyle}">
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}"/>
    </Style>

    <!-- ============================================
         FICHE MÉDICAMENT
    ============================================ -->

    <Style x:Key="MedicCardContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BoneBrush}"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="Margin" Value="6"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MedicCardHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BotanicalBrush}"/>
        <Setter Property="CornerRadius" Value="2,2,0,0"/>
        <Setter Property="Padding" Value="20,16"/>
    </Style>

    <Style x:Key="MedicCardSectionStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="Padding" Value="16,12"/>
    </Style>

    <!-- ============================================
         BADGES / TAGS — petits, posés sur la palette
    ============================================ -->

    <Style x:Key="CategoryBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Background" Value="{DynamicResource BotanicalLightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BotanicalBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="PediatricBadgeStyle" TargetType="Border" BasedOn="{StaticResource CategoryBadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource OchreLightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OchreBrush}"/>
    </Style>

    <Style x:Key="GenericBadgeStyle" TargetType="Border" BasedOn="{StaticResource CategoryBadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource MossLightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MossBrush}"/>
    </Style>

    <Style x:Key="ControlledBadgeStyle" TargetType="Border" BasedOn="{StaticResource CategoryBadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource VermillionLightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource VermillionBrush}"/>
    </Style>

    <!-- ============================================
         PANELS DE GROUPE
    ============================================ -->

    <Style x:Key="GroupPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PaperBrush}"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="0,8"/>
    </Style>

    <!-- ============================================
         LIGNE DE LISTE (« ledger row »)
    ============================================ -->

    <Style x:Key="ListItemCardStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Margin" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BoneBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================
         INFO BOX — barre verticale gauche, fond doux
    ============================================ -->

    <Style x:Key="InfoBoxStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource IndigoLightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource IndigoBrush}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Margin" Value="0,8"/>
    </Style>

    <Style x:Key="SuccessBoxStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MossLightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MossDarkBrush}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Margin" Value="0,8"/>
    </Style>

    <Style x:Key="WarningBoxStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource OchreLightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OchreDarkBrush}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Margin" Value="0,8"/>
    </Style>

    <Style x:Key="ErrorBoxStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource VermillionLightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource VermillionBrush}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Margin" Value="0,8"/>
    </Style>

</ResourceDictionary>
