<UserControl x:Class="AVCNDB.WPF.Views.InteractionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AVCNDB.WPF.Converters"
             xmlns:vm="clr-namespace:AVCNDB.WPF.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InteractionsViewModel}"
             Background="{DynamicResource MaterialDesignBackground}"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================
             DRUG PICKER BAR
        ============================================ -->
        <Border Grid.Row="0"
                Background="{DynamicResource MaterialDesignPaper}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Slot A ── -->
                <Border Grid.Column="0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="Médicament A"
                                   Style="{StaticResource TitleH3Style}"
                                   Margin="0,0,0,6"/>

                        <TextBox Text="{Binding DrugASearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Rechercher un médicament..."
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 Height="36"
                                 FontSize="13"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,0,8"/>

                        <ListBox ItemsSource="{Binding DrugASearchResults}"
                                 SelectedItem="{Binding SelectedDrugA, Mode=TwoWay}"
                                 MaxHeight="160"
                                 Visibility="{Binding SelectedDrugA, Converter={StaticResource NullToVis}, ConverterParameter=invert}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding itemname}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="DCI: "/>
                                            <Run Text="{Binding dci1}"/>
                                            <Run Text="  ·  Voie: "/>
                                            <Run Text="{Binding voie}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Selected drug card -->
                        <Border Visibility="{Binding SelectedDrugA, Converter={StaticResource NullToVis}}"
                                Background="{DynamicResource MaterialDesignBackground}"
                                CornerRadius="4"
                                Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding SelectedDrugA.itemname}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="DCI: "/>
                                        <Run Text="{Binding SelectedDrugA.dci1}"/>
                                        <Run Text="  ·  Voie: "/>
                                        <Run Text="{Binding SelectedDrugA.voie}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding ClearDrugACommand}"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Retirer"
                                        Width="28" Height="28">
                                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── Center: Analyze button ── -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="SwapHorizontal"
                                             Width="36" Height="36"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             HorizontalAlignment="Center"
                                             Margin="0,0,0,8"/>
                    <Button Command="{Binding AnalyzeWithAiCommand}"
                            IsEnabled="{Binding CanAnalyze}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="6"
                            Height="38"
                            Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <ProgressBar IsIndeterminate="True"
                                         Width="16" Height="16"
                                         Style="{StaticResource MaterialDesignCircularProgressBar}"
                                         Visibility="{Binding IsDeepAnalysisRunning, Converter={StaticResource BoolToVis}}"
                                         Margin="0,0,8,0"/>
                            <materialDesign:PackIcon Kind="Brain"
                                                     Width="16" Height="16"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding IsDeepAnalysisRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                            <TextBlock Text="Analyser avec IA"
                                       Margin="8,0,0,0"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LaunchMlPfeCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            ToolTip="Ouvrir l'interface IA de prédiction des contre-indications patient (ML_pfe)"
                            Margin="0,8,0,0"
                            Height="30"
                            Padding="10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Stethoscope" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="CI patient (ML_pfe)" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ── Slot B ── -->
                <Border Grid.Column="2"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="Médicament B"
                                   Style="{StaticResource TitleH3Style}"
                                   Margin="0,0,0,6"/>

                        <TextBox Text="{Binding DrugBSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Rechercher un médicament..."
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 Height="36"
                                 FontSize="13"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,0,8"/>

                        <ListBox ItemsSource="{Binding DrugBSearchResults}"
                                 SelectedItem="{Binding SelectedDrugB, Mode=TwoWay}"
                                 MaxHeight="160"
                                 Visibility="{Binding SelectedDrugB, Converter={StaticResource NullToVis}, ConverterParameter=invert}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding itemname}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="DCI: "/>
                                            <Run Text="{Binding dci1}"/>
                                            <Run Text="  ·  Voie: "/>
                                            <Run Text="{Binding voie}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Visibility="{Binding SelectedDrugB, Converter={StaticResource NullToVis}}"
                                Background="{DynamicResource MaterialDesignBackground}"
                                CornerRadius="4"
                                Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding SelectedDrugB.itemname}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="DCI: "/>
                                        <Run Text="{Binding SelectedDrugB.dci1}"/>
                                        <Run Text="  ·  Voie: "/>
                                        <Run Text="{Binding SelectedDrugB.voie}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding ClearDrugBCommand}"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Retirer"
                                        Width="28" Height="28">
                                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================
             RESULTS AREA — filled in by Task 10
        ============================================ -->
        <Grid Grid.Row="1">
            <!-- TASK_10_RESULTS -->
            <TextBlock Text="(Résultats — à implémenter en Task 10)"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontStyle="Italic"/>
        </Grid>
    </Grid>
</UserControl>
