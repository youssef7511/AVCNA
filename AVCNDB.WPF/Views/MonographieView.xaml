<UserControl x:Class="AVCNDB.WPF.Views.MonographieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AVCNDB.WPF.ViewModels"
             xmlns:helpers="clr-namespace:AVCNDB.WPF.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MonographieViewModel}"
             Background="{DynamicResource MaterialDesignBackground}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Date display style -->
        <Style x:Key="DateCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================
             BARRE D'OUTILS
        ============================================ -->
        <Border Grid.Row="0"
                Background="{DynamicResource MaterialDesignPaper}"
                Padding="10,6"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Search bar -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBox materialDesign:TextFieldAssist.HasClearButton="True"
                             Width="400"
                             Height="36"
                             Padding="10,6"
                             VerticalContentAlignment="Center"
                             FontSize="13"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Rechercher par code PCT, dénomination, DCI, voie, labo..."
                             materialDesign:HintAssist.IsFloating="False"
                             materialDesign:TextFieldAssist.DecorationVisibility="Visible"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,12,0"/>
                </StackPanel>

                <!-- Row 1: Filter & action buttons -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <!-- Erreur -->
                    <Border Background="{StaticResource ErrorLightBrush}"
                            CornerRadius="6"
                            Padding="10,6"
                            Margin="0,0,12,0"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotNullOrEmptyToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircle" Width="18" Height="18"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource ErrorDarkBrush}"/>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource ErrorDarkBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Tout afficher -->
                    <Button Command="{Binding ShowAllCommand}"
                            Style="{StaticResource TabToolbarSecondaryButtonStyle}"
                            Margin="0,0,6,0"
                            ToolTip="Afficher tous les médicaments">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FormatListBulleted" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Tout afficher" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Avec monographie -->
                    <Button Command="{Binding ShowWithMonographCommand}"
                            Style="{StaticResource TabToolbarSecondaryButtonStyle}"
                            Margin="0,0,6,0"
                            ToolTip="Afficher les médicaments avec date de monographie">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BookCheck" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Avec monographie" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Sans monographie -->
                    <Button Command="{Binding ShowWithoutMonographCommand}"
                            Style="{StaticResource TabToolbarSecondaryButtonStyle}"
                            Margin="0,0,6,0"
                            ToolTip="Afficher les médicaments sans date de monographie">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BookRemove" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Sans monographie" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Sans voie -->
                    <Button Command="{Binding ShowWithoutVoieCommand}"
                            Style="{StaticResource TabToolbarSecondaryButtonStyle}"
                            Margin="0,0,6,0"
                            ToolTip="Afficher les médicaments sans voie d'administration">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="MapMarkerOff" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Sans voie" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Sans groupe formes -->
                    <Button Command="{Binding ShowWithoutFormGroupCommand}"
                            Style="{StaticResource TabToolbarSecondaryButtonStyle}"
                            Margin="0,0,6,0"
                            ToolTip="Afficher les médicaments sans groupe de formes">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Shape" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Sans grp. formes" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="6,4,12,4"/>

                    <!-- Dater monographie -->
                    <Button Command="{Binding SetMonographDateCommand}"
                            Style="{StaticResource TabToolbarSecondaryButtonStyle}"
                            Margin="0,0,6,0"
                            ToolTip="Définir la date de monographie à aujourd'hui pour les affichés">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarCheck" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Dater monographie" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Effacer dates -->
                    <Button Command="{Binding ClearMonographDatesCommand}"
                            Style="{StaticResource TabToolbarSecondaryButtonStyle}"
                            Margin="0,0,6,0"
                            ToolTip="Effacer les dates de monographie des médicaments affichés">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarRemove" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Effacer dates" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Restaurer -->
                    <Button Command="{Binding RestoreAllCommand}"
                            Style="{StaticResource TabToolbarSecondaryButtonStyle}"
                            Margin="0,0,6,0"
                            ToolTip="Recharger les données depuis la base (annule les modifications)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Restore" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Restaurer" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="6,4,12,4"/>

                    <!-- Appliquer -->
                    <Button Command="{Binding ApplyMonographiesCommand}"
                            Style="{StaticResource TabToolbarPrimaryButtonStyle}"
                            ToolTip="Sauvegarder toutes les modifications dans la base">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Appliquer" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>


            </Grid>
        </Border>

        <!-- ============================================
             DATAGRID EDITABLE — MONOGRAPHIES
        ============================================ -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding MedicsView}"
                  SelectedItem="{Binding SelectedMedic}"
                  Style="{StaticResource EditableDataGridStyle}"
                  RowHeight="36"
                  Margin="0,2,0,0"
                  HorizontalAlignment="Left"
                  HorizontalScrollBarVisibility="Auto"
                  CellEditEnding="DataGrid_CellEditEnding">

            <DataGrid.Resources>
                <helpers:BindingProxy x:Key="vmProxy" Data="{Binding}"/>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <!-- Code PCT (hidden) -->
                <DataGridTextColumn Header="Code PCT"
                                    Binding="{Binding pctcode}"
                                    Width="85"
                                    IsReadOnly="True"
                                    Visibility="Collapsed"/>

                <!-- Dénomination (hidden) -->
                <DataGridTextColumn Header="Dénomination"
                                    Binding="{Binding itemname}"
                                    Width="280"
                                    IsReadOnly="True"
                                    Visibility="Collapsed">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding itemname}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- DCI (ComboBox) -->
                <DataGridTemplateColumn Header="D.C.I" Width="180" SortMemberPath="dci" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding dci}" VerticalAlignment="Center"
                                       Margin="8,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding dci}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Data.DciList, Source={StaticResource vmProxy}}"
                                      Text="{Binding dci, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      Style="{StaticResource MaterialDesignDataGridComboBox}"
                                      Foreground="{DynamicResource MaterialDesignBody}"
                                      Background="{DynamicResource MaterialDesignPaper}"
                                      FontSize="13"
                                      Padding="10,6"
                                      Height="32"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Forme (ComboBox) -->
                <DataGridTemplateColumn Header="Forme" Width="100" SortMemberPath="forme" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding forme}" VerticalAlignment="Center"
                                       Margin="8,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding forme}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Data.FormesList, Source={StaticResource vmProxy}}"
                                      Text="{Binding forme, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      Style="{StaticResource MaterialDesignDataGridComboBox}"
                                      Foreground="{DynamicResource MaterialDesignBody}"
                                      Background="{DynamicResource MaterialDesignPaper}"
                                      FontSize="13"
                                      Padding="10,6"
                                      Height="32"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Voie (ComboBox) -->
                <DataGridTemplateColumn Header="Voie" Width="120" SortMemberPath="voie" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding voie}" VerticalAlignment="Center"
                                       Margin="8,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding voie}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Data.VoiesList, Source={StaticResource vmProxy}}"
                                      Text="{Binding voie, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      Style="{StaticResource MaterialDesignDataGridComboBox}"
                                      Foreground="{DynamicResource MaterialDesignBody}"
                                      Background="{DynamicResource MaterialDesignPaper}"
                                      FontSize="13"
                                      Padding="10,6"
                                      Height="32"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- G.formes (ComboBox from Formes.formgroup) -->
                <DataGridTemplateColumn Header="G.formes" Width="100" SortMemberPath="formgroup" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding formgroup}" VerticalAlignment="Center"
                                       Margin="8,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding formgroup}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Data.FormGroupsList, Source={StaticResource vmProxy}}"
                                      Text="{Binding formgroup, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      Style="{StaticResource MaterialDesignDataGridComboBox}"
                                      Foreground="{DynamicResource MaterialDesignBody}"
                                      Background="{DynamicResource MaterialDesignPaper}"
                                      FontSize="13"
                                      Padding="10,6"
                                      Height="32"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Date monographie (editable via template with DatePicker) -->
                <DataGridTemplateColumn Header="Date monographie"
                                        Width="140"
                                        SortMemberPath="monogat"
                                        CanUserSort="True"
                                        Visibility="Collapsed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding monogat, StringFormat=dd/MM/yyyy}"
                                       Style="{StaticResource DateCellStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding monogat, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Date CI -->
                <DataGridTemplateColumn Header="Date C.I"
                                        Width="120"
                                        SortMemberPath="ciat"
                                        CanUserSort="True"
                                        Visibility="Collapsed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ciat, StringFormat=dd/MM/yyyy}"
                                       Style="{StaticResource DateCellStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding ciat, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- V.E.I.C (hidden) -->
                <DataGridTextColumn Header="V.E.I.C"
                                    Binding="{Binding veic}"
                                    Width="52"
                                    IsReadOnly="True"
                                    Visibility="Collapsed"/>

                <!-- Cat pharm. (hidden) -->
                <DataGridTextColumn Header="Cat pharm."
                                    Binding="{Binding specialite}"
                                    Width="90"
                                    IsReadOnly="True"
                                    Visibility="Collapsed">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding specialite}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Labo (ComboBox) -->
                <DataGridTemplateColumn Header="Labo" Width="180" SortMemberPath="labo" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding labo}" VerticalAlignment="Center"
                                       Margin="8,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding labo}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Data.LabosList, Source={StaticResource vmProxy}}"
                                      Text="{Binding labo, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      Style="{StaticResource MaterialDesignDataGridComboBox}"
                                      Foreground="{DynamicResource MaterialDesignBody}"
                                      Background="{DynamicResource MaterialDesignPaper}"
                                      FontSize="13"
                                      Padding="10,6"
                                      Height="32"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Date d'ajout (hidden) -->
                <DataGridTemplateColumn Header="Date d'ajout"
                                        Width="110"
                                        IsReadOnly="True"
                                        SortMemberPath="addedat"
                                        CanUserSort="True"
                                        Visibility="Collapsed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding addedat, StringFormat=dd/MM/yyyy}"
                                       Style="{StaticResource DateCellStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Date modif (hidden) -->
                <DataGridTemplateColumn Header="Date modif"
                                        Width="110"
                                        IsReadOnly="True"
                                        SortMemberPath="updatedat"
                                        CanUserSort="True"
                                        Visibility="Collapsed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding updatedat, StringFormat=dd/MM/yyyy}"
                                       Style="{StaticResource DateCellStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Indicateur de chargement -->
        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                     VerticalAlignment="Top"
                     Margin="0"/>

        <!-- ============================================
             BARRE INFÉRIEURE — Filtre actif + compteur
        ============================================ -->
        <Border Grid.Row="2"
                Background="{DynamicResource MaterialDesignPaper}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filtre actif -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Filter" Width="16" Height="16"
                                             VerticalAlignment="Center"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             Margin="0,0,6,0"/>
                    <TextBlock Text="Filtre :"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <Border Background="{StaticResource InfoLightBrush}"
                            CornerRadius="4"
                            Padding="8,3">
                        <TextBlock Text="{Binding ActiveFilterText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InfoDarkBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Compteurs -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Indicateur modifications non sauvegardées -->
                    <Border Background="{StaticResource WarningLightBrush}"
                            CornerRadius="4"
                            Padding="8,4"
                            Margin="0,0,12,0"
                            Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Alert" Width="14" Height="14"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource WarningDarkBrush}"/>
                            <TextBlock Text="Modifications non sauvegardées"
                                       Margin="6,0,0,0"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource WarningDarkBrush}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock VerticalAlignment="Center" FontSize="12">
                        <Run Text="Lignes affichées : "/>
                        <Run Text="{Binding FilteredCount, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
