<UserControl x:Class="AVCNDB.WPF.Views.MedicListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AVCNDB.WPF.ViewModels"
             xmlns:helpers="clr-namespace:AVCNDB.WPF.Helpers"
             xmlns:controls="clr-namespace:AVCNDB.WPF.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MedicListViewModel}"
             Background="{DynamicResource MaterialDesignBackground}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="GridComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================
             BARRE D'OUTILS
        ============================================ -->
        <Border Grid.Row="0" 
                Background="{DynamicResource MaterialDesignPaper}"
                Padding="10,6"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Recherche et filtres -->
                <StackPanel Grid.Column="0">
                    <!-- Erreur de chargement (ex: DB indisponible) -->
                    <Border Background="{StaticResource ErrorLightBrush}"
                            CornerRadius="6"
                            Padding="10,6"
                            Margin="0,0,0,12"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotNullOrEmptyToVisibility}}">

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircle" Width="18" Height="18" VerticalAlignment="Center" Foreground="{StaticResource ErrorDarkBrush}"/>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource ErrorDarkBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <!-- Barre de recherche -->
                        <TextBox materialDesign:TextFieldAssist.HasClearButton="True" Width="350"
                                 Height="36"
                                 Padding="10,6"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Rechercher par nom, DCI, code-barre..."
                                 materialDesign:HintAssist.IsFloating="False"
                                 materialDesign:TextFieldAssist.DecorationVisibility="Visible"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,12,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- Toggle filtres -->
                        <ToggleButton IsChecked="{Binding ShowFilters}"
                                      Style="{StaticResource OutlinedToggleButtonStyle}"
                                      Margin="0,0,8,0"
                                      ToolTip="Afficher/masquer les filtres">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Filter" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Filtres" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <!-- Reset -->
                        <Button Command="{Binding ClearSearchCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Réinitialiser recherche + filtres">
                            <materialDesign:PackIcon Kind="FilterRemove" Width="20" Height="20"/>
                        </Button>
                    </StackPanel>

                    <!-- Filtres avancés (collapsible) -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,12,0,0"
                                Visibility="{Binding ShowFilters, Converter={StaticResource BoolToVis}}">
                        <controls:FilterableComboBox Width="220"
                                  FilterableItemsSource="{Binding Families}"
                                  SelectedItem="{Binding SelectedFamily}"
                                  DisplayMemberPath="itemname"
                                  materialDesign:HintAssist.Hint="Famille"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Margin="0,0,12,0"/>

                        <controls:FilterableComboBox Width="220"
                                  FilterableItemsSource="{Binding Labos}"
                                  SelectedItem="{Binding SelectedLabo}"
                                  DisplayMemberPath="itemname"
                                  materialDesign:HintAssist.Hint="Laboratoire"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Margin="0,0,12,0"/>

                        <CheckBox IsChecked="{Binding ShowActiveOnly}"
                                  VerticalAlignment="Center"
                                  Content="Actifs uniquement"
                                  Margin="0,0,12,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Nouveau -->
                    <Button Command="{Binding NewMedicCommand}"
                            Style="{StaticResource TabToolbarPrimaryButtonStyle}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Nouveau" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Import Excel -->
                    <Button Command="{Binding ImportFromExcelCommand}"
                            Style="{StaticResource TabToolbarSecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="Importer depuis Excel">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="MicrosoftExcel" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Import" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Modèle Excel (template strict) -->
                    <Button Command="{Binding DownloadExcelTemplateCommand}"
                            Style="{StaticResource TabToolbarSecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="Télécharger le modèle Excel (template strict)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Modèle" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Export Excel -->
                    <Button Command="{Binding ExportToExcelCommand}"
                            Style="{StaticResource TabToolbarSecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="Exporter vers Excel">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Download" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Export" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Export PDF -->
                    <Button Command="{Binding ExportToPdfCommand}"
                            Style="{StaticResource TabToolbarIconButtonStyle}"
                            ToolTip="Exporter en PDF">
                        <materialDesign:PackIcon Kind="FilePdfBox" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================
             LISTE DES MÉDICAMENTS
        ============================================ -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Medics}"
                  SelectedItem="{Binding SelectedMedic}"
                  Style="{StaticResource ModernDataGridStyle}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  RowHeight="34"
                  ColumnHeaderHeight="38"
                  materialDesign:DataGridAssist.SelectedCellBorderBrush="Transparent"
                  Margin="0,4,0,0"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False">

            <DataGrid.Resources>
                <helpers:BindingProxy x:Key="vmProxy" Data="{Binding}"/>
            </DataGrid.Resources>

            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" 
                              Command="{Binding ViewDetailCommand}"
                              CommandParameter="{Binding SelectedMedic}"/>
            </DataGrid.InputBindings>

            <DataGrid.Columns>
                <!-- Sélection -->
                <DataGridTemplateColumn Width="45" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Hidden recordid for CRUD -->
                <DataGridTextColumn Header="recordid" Visibility="Collapsed"
                                    Binding="{Binding recordid}"/>

                <!-- Code PCT -->
                <DataGridTextColumn Header="Code"
                                    Binding="{Binding pctcode}"
                                    Width="75"/>

                <!-- AMM -->
                <DataGridTextColumn Header="AMM"
                                    Binding="{Binding amm}"
                                    Width="70"/>

                <!-- Dénomination (Nom du médicament) -->
                <DataGridTemplateColumn Header="Dénomination" Width="*" MinWidth="220" SortMemberPath="itemname">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding itemname}"
                                       Style="{StaticResource MedicNameStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding itemname}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Spécialité -->
                <DataGridTextColumn Header="Spéc." Width="90" SortMemberPath="specialite"
                                    Binding="{Binding specialite}"/>

                <!-- D.C.I -->
                <DataGridTextColumn Header="DCI" Width="120" SortMemberPath="dci1"
                                    Binding="{Binding dci1}"/>

                <!-- Familles -->
                <DataGridTextColumn Header="Famille" Width="120" SortMemberPath="fam1"
                                    Binding="{Binding fam1}"/>

                <!-- Laboratoire -->
                <DataGridTextColumn Header="Labo" Width="100" SortMemberPath="labo"
                                    Binding="{Binding labo}"/>

                <!-- VEIC -->
                <DataGridTextColumn Header="VEIC" Width="48" SortMemberPath="veic"
                                    Binding="{Binding veic}"/>

                <!-- Tableau -->
                <DataGridTextColumn Header="Tab"
                                    Binding="{Binding tableau}"
                                    Width="40"/>

                <!-- Forme -->
                <DataGridTextColumn Header="Forme" Width="90" SortMemberPath="forme"
                                    Binding="{Binding forme}"/>

                <!-- Présentation -->
                <DataGridTextColumn Header="Prés." Width="90" SortMemberPath="present"
                                    Binding="{Binding present}"/>

                <!-- A.P. (Générique) -->
                <DataGridTemplateColumn Header="AP" Width="35" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="G" FontWeight="Bold"
                                       Foreground="{StaticResource SecondaryDarkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding isap, Converter={StaticResource IntToBoolConverter}, ConverterParameter=x}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Prix réf (refprice) -->
                <DataGridTemplateColumn Header="P.Réf" Width="70" SortMemberPath="refprice">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding refprice, StringFormat={}{0:N0}}"
                                       Style="{StaticResource PriceTextStyle}"
                                       HorizontalAlignment="Right" Margin="0,0,6,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Prix de vente (price) -->
                <DataGridTemplateColumn Header="PPV" Width="70" SortMemberPath="price">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding price, StringFormat={}{0:N0}}"
                                       Style="{StaticResource PriceTextStyle}"
                                       HorizontalAlignment="Right" Margin="0,0,6,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Mont PEC (pamount) -->
                <DataGridTemplateColumn Header="PEC" Width="65" SortMemberPath="pamount">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding pamount, StringFormat={}{0:N0}}"
                                       Style="{StaticResource PriceTextStyle}"
                                       HorizontalAlignment="Right" Margin="0,0,6,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Hidden dates for CRUD -->
                <DataGridTextColumn Header="addedat" Visibility="Collapsed"
                                    Binding="{Binding addedat, StringFormat=\{0:dd/MM/yyyy\}}"/>
                <DataGridTextColumn Header="updatedat" Visibility="Collapsed"
                                    Binding="{Binding updatedat, StringFormat=\{0:dd/MM/yyyy\}}"/>

                <!-- Actions (⋮ menu) -->
                <DataGridTemplateColumn Header="" Width="50" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges"
                                                     StaysOpen="False" ToolTip="Actions" Padding="0"
                                                     HorizontalAlignment="Center">
                                <materialDesign:PopupBox.ToggleContent>
                                    <materialDesign:PackIcon Kind="DotsVertical" Width="20" Height="20"
                                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                                </materialDesign:PopupBox.ToggleContent>
                                <StackPanel MinWidth="160">
                                    <Button Command="{Binding Data.ViewDetailCommand, Source={StaticResource vmProxy}}"
                                            CommandParameter="{Binding}"
                                            HorizontalContentAlignment="Left" Padding="16,10">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Eye" Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Voir détails" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding Data.EditMedicCommand, Source={StaticResource vmProxy}}"
                                            CommandParameter="{Binding}"
                                            HorizontalContentAlignment="Left" Padding="16,10">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                                            <TextBlock Text="Modifier" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding Data.DeleteMedicCommand, Source={StaticResource vmProxy}}"
                                            CommandParameter="{Binding}"
                                            HorizontalContentAlignment="Left" Padding="16,10">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource ErrorBrush}"/>
                                            <TextBlock Text="Supprimer" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </materialDesign:PopupBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Indicateur de chargement -->
        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                     VerticalAlignment="Top"
                     Margin="0"/>

        <!-- ============================================
             PAGINATION
        ============================================ -->
        <Border Grid.Row="2" 
                Background="{DynamicResource MaterialDesignPaper}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Infos -->
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center">
                    <Run Text="Affichage de "/>
                    <Run Text="{Binding StartIndex, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text=" à "/>
                    <Run Text="{Binding EndIndex, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text=" sur "/>
                    <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text=" médicaments"/>
                </TextBlock>

                <!-- Boutons de navigation -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding FirstPageCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            IsEnabled="{Binding CanGoPrevious}"
                            ToolTip="Première page">
                        <materialDesign:PackIcon Kind="ChevronDoubleLeft" Width="20" Height="20"/>
                    </Button>
                    
                    <Button Command="{Binding PreviousPageCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            IsEnabled="{Binding CanGoPrevious}"
                            ToolTip="Page précédente">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="20" Height="20"/>
                    </Button>

                    <Border Background="{StaticResource PrimaryBrush}" 
                            CornerRadius="4" 
                            Padding="12,6"
                            Margin="8,0">
                        <TextBlock Foreground="White">
                            <Run Text="Page "/>
                            <Run Text="{Binding CurrentPage, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text=" / "/>
                            <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>

                    <Button Command="{Binding NextPageCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            IsEnabled="{Binding CanGoNext}"
                            ToolTip="Page suivante">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20"/>
                    </Button>
                    
                    <Button Command="{Binding LastPageCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            IsEnabled="{Binding CanGoNext}"
                            ToolTip="Dernière page">
                        <materialDesign:PackIcon Kind="ChevronDoubleRight" Width="20" Height="20"/>
                    </Button>
                </StackPanel>

                <!-- Taille de page -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <TextBlock Text="Éléments par page :" 
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox Width="80"
                              SelectedValue="{Binding PageSize}"
                              SelectedValuePath="Content"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}">
                        <ComboBoxItem Content="25"/>
                        <ComboBoxItem Content="50"/>
                        <ComboBoxItem Content="100"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>


