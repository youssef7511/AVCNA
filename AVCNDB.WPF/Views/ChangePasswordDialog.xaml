<Window x:Class="AVCNDB.WPF.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:AVCNDB.WPF.ViewModels"
        xmlns:helpers="clr-namespace:AVCNDB.WPF.Helpers"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ChangePasswordDialogViewModel}"
        Title="Changer le mot de passe"
        Width="420" Height="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        ShowInTaskbar="False">

    <Grid Margin="40,28,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <materialDesign:PackIcon Grid.Row="0"
                                  Kind="LockReset"
                                  Width="40" Height="40"
                                  HorizontalAlignment="Center"
                                  Foreground="{StaticResource PrimaryHueMidBrush}"
                                  Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   Text="Changement de mot de passe"
                   FontSize="17"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="Black"
                   Margin="0,0,0,4"/>

        <TextBlock Grid.Row="2"
                   Text="Votre mot de passe doit être modifié avant de continuer."
                   FontSize="12"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                   Margin="0,0,0,24"/>

        <!-- Mot de passe actuel -->
        <PasswordBox Grid.Row="3"
                     Style="{StaticResource MaterialDesignFilledPasswordBox}"
                     materialDesign:HintAssist.Hint="Mot de passe actuel"
                     helpers:PasswordBoxHelper.BindPassword="True"
                     helpers:PasswordBoxHelper.BoundPassword="{Binding CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Foreground="Black"
                     Margin="0,0,0,12"/>

        <!-- Nouveau mot de passe -->
        <PasswordBox Grid.Row="4"
                     Style="{StaticResource MaterialDesignFilledPasswordBox}"
                     materialDesign:HintAssist.Hint="Nouveau mot de passe (8 caractères min.)"
                     helpers:PasswordBoxHelper.BindPassword="True"
                     helpers:PasswordBoxHelper.BoundPassword="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Foreground="Black"
                     Margin="0,0,0,12"/>

        <!-- Confirmation -->
        <PasswordBox Grid.Row="5"
                     Style="{StaticResource MaterialDesignFilledPasswordBox}"
                     materialDesign:HintAssist.Hint="Confirmer le nouveau mot de passe"
                     helpers:PasswordBoxHelper.BindPassword="True"
                     helpers:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Foreground="Black"
                     Margin="0,0,0,4"/>

        <!-- Live validation hints (length + match) -->
        <StackPanel Grid.Row="5" VerticalAlignment="Bottom" Margin="2,0,0,-22">
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding ShowLengthHint, Converter={StaticResource BoolToVisibility}}">
                <materialDesign:PackIcon Kind="AlertOutline" Width="13" Height="13"
                                         Foreground="#E65100" VerticalAlignment="Center"/>
                <TextBlock Text="Le nouveau mot de passe doit faire 8 caractères minimum."
                           FontSize="11" Foreground="#E65100"
                           VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding ShowMatchMismatch, Converter={StaticResource BoolToVisibility}}">
                <materialDesign:PackIcon Kind="CloseCircleOutline" Width="13" Height="13"
                                         Foreground="#C62828" VerticalAlignment="Center"/>
                <TextBlock Text="Les deux mots de passe ne correspondent pas."
                           FontSize="11" Foreground="#C62828"
                           VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding ShowMatchOk, Converter={StaticResource BoolToVisibility}}">
                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="13" Height="13"
                                         Foreground="#2E7D32" VerticalAlignment="Center"/>
                <TextBlock Text="Les mots de passe correspondent."
                           FontSize="11" Foreground="#2E7D32"
                           VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Bandeau d'erreur -->
        <Border Grid.Row="6"
                Background="#FFEBEE"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,0,0,12"
                Visibility="{Binding HasChangeError, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="AlertCircle"
                                         Width="18" Height="18"
                                         Foreground="#C62828"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>
                <TextBlock Text="{Binding ChangeError}"
                           Foreground="#C62828"
                           FontSize="13"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Boutons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Command="{Binding CancelCommand}"
                    Margin="0,0,10,0"
                    MinWidth="90"/>
            <Button Content="Valider"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding ChangePasswordCommand}"
                    MinWidth="100"/>
        </StackPanel>
    </Grid>
</Window>
