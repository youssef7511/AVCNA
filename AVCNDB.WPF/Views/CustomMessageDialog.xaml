<Window x:Class="AVCNDB.WPF.Views.CustomMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Message"
        Width="480"
        SizeToContent="Height"
        MaxHeight="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <materialDesign:Card UniformCornerRadius="10"
                         materialDesign:ElevationAssist.Elevation="Dp8"
                         Background="{DynamicResource MaterialDesignPaper}"
                         Padding="0"
                         Margin="8">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Colored top strip with icon + title -->
            <Border x:Name="StripBorder"
                    Grid.Row="0"
                    CornerRadius="10,10,0,0"
                    Padding="16,14">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon x:Name="StripIcon"
                                             Width="24" Height="24"
                                             VerticalAlignment="Center"
                                             Foreground="White"/>
                    <TextBlock x:Name="TitleText"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Message body — ScrollViewer so long messages don't push off-screen -->
            <Border Grid.Row="1" Padding="20,16,20,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              MaxHeight="380">
                    <TextBlock x:Name="MessageText"
                               FontSize="13"
                               Foreground="{DynamicResource MaterialDesignBody}"
                               TextWrapping="Wrap"
                               LineHeight="20"/>
                </ScrollViewer>
            </Border>

            <!-- Button row -->
            <Border Grid.Row="2" Padding="16,0,16,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SecondaryButton"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,10,0"
                            MinWidth="90"
                            Visibility="Collapsed"
                            Click="SecondaryButton_Click"/>
                    <Button x:Name="PrimaryButton"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            MinWidth="90"
                            Click="PrimaryButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </materialDesign:Card>
</Window>
