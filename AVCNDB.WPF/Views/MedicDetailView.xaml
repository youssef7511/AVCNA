<UserControl x:Class="AVCNDB.WPF.Views.MedicDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AVCNDB.WPF.Converters"
             xmlns:vm="clr-namespace:AVCNDB.WPF.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MedicDetailViewModel}"
             Background="{DynamicResource MaterialDesignBackground}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>

        <!-- Compact label -->
        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- Compact value -->
        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Compact card for this view -->
        <Style x:Key="DetailCardStyle" TargetType="Border" BasedOn="{StaticResource ElevatedCardStyle}">
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <!-- Section header with icon -->
        <Style x:Key="SectionHeaderPanel" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Main content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Padding="20,12"
                      Visibility="{Binding Medic, Converter={StaticResource NullToVis}}">
            <StackPanel MaxWidth="1300">

                <!-- ══════════════════════════════════════════
                     TOP BAR: Back + Actions
                ══════════════════════════════════════════ -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding GoBackCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Padding="10,6"
                            Height="34">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Retour" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Command="{Binding CopyToClipboardCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="Copier les informations"
                                Margin="0,0,6,0" Padding="10,6" Height="34">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy" Width="15" Height="15" VerticalAlignment="Center"/>
                                <TextBlock Text="Copier" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ExportToPdfCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,6,0" Padding="10,6" Height="34">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Width="15" Height="15" VerticalAlignment="Center"/>
                                <TextBlock Text="PDF" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding PrintCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,6,0" Padding="10,6" Height="34">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="15" Height="15" VerticalAlignment="Center"/>
                                <TextBlock Text="Imprimer" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding EditCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="White"
                                Padding="14,6" Height="34">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Pencil" Width="15" Height="15" VerticalAlignment="Center"/>
                                <TextBlock Text="Modifier" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ══════════════════════════════════════════
                     HERO CARD: Drug Name + Badges + Chips
                ══════════════════════════════════════════ -->
                <Border Style="{StaticResource DetailCardStyle}" Margin="0,0,0,12" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <!-- Badges row -->
                            <WrapPanel Margin="0,0,0,8">
                                <!-- Active/Inactive -->
                                <Border CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource ErrorLightBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="10.5" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="INACTIF"/>
                                                <Setter Property="Foreground" Value="{StaticResource ErrorDarkBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Text" Value="✓ ACTIF"/>
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessDarkBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <Border Style="{StaticResource PediatricBadgeStyle}"
                                        Visibility="{Binding IsPediatric, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,6,4">
                                    <TextBlock Text="👶 PÉDIATRIQUE" FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>

                                <Border Style="{StaticResource GenericBadgeStyle}"
                                        Visibility="{Binding IsGeneric, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,6,4">
                                    <TextBlock Text="GÉNÉRIQUE" FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>

                                <Border Style="{StaticResource ControlledBadgeStyle}"
                                        Visibility="{Binding IsControlled, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,6,4">
                                    <TextBlock FontSize="10.5" FontWeight="SemiBold">
                                        <Run Text="⚠️ TABLEAU"/><Run Text=" "/><Run Text="{Binding Medic.tableau, Mode=OneWay, TargetNullValue='', FallbackValue=''}"/>
                                    </TextBlock>
                                </Border>

                                <!-- OTC badge -->
                                <Border CornerRadius="4" Padding="8,3" Margin="0,0,6,4"
                                        Background="{StaticResource BorderLightBrush}"
                                        Visibility="{Binding IsOtc, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="OTC" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>

                                <!-- Reimbursable badge -->
                                <Border CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource ErrorLightBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReimbursable}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="10.5" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="NON REMB."/>
                                                <Setter Property="Foreground" Value="{StaticResource ErrorDarkBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReimbursable}" Value="True">
                                                        <Setter Property="Text" Value="✓ REMBOURSABLE"/>
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessDarkBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </WrapPanel>

                            <!-- Drug name -->
                            <TextBlock Text="{Binding Medic.itemname, TargetNullValue='—', FallbackValue='—'}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryDarkBrush}"
                                       TextWrapping="Wrap"/>

                            <!-- DCI -->
                            <TextBlock Text="{Binding Medic.dci, TargetNullValue='—', FallbackValue='—'}"
                                       Style="{StaticResource DciTextStyle}"
                                       FontSize="14.5" Margin="0,4,0,0"/>

                            <!-- Info chips -->
                            <WrapPanel Margin="0,12,0,0">
                                <Border Background="{StaticResource BorderLightBrush}" CornerRadius="14"
                                        Padding="12,4" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Pill" Width="14" Height="14"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Medic.forme, TargetNullValue='-'}"
                                                   Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource BorderLightBrush}" CornerRadius="14"
                                        Padding="12,4" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Needle" Width="14" Height="14"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Medic.voie, TargetNullValue='-'}"
                                                   Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource BorderLightBrush}" CornerRadius="14"
                                        Padding="12,4" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PackageVariant" Width="14" Height="14"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Medic.present, TargetNullValue='-'}"
                                                   Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource BorderLightBrush}" CornerRadius="14"
                                        Padding="12,4" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Factory" Width="14" Height="14"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Medic.labo, TargetNullValue='-'}"
                                                   Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource BorderLightBrush}" CornerRadius="14"
                                        Padding="12,4" Margin="0,0,8,6"
                                        Visibility="{Binding HasSpecialite, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Star" Width="14" Height="14"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Medic.specialite}"
                                                   Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <!-- PPV highlight on the right of hero -->
                        <Border Grid.Column="1"
                                Background="{StaticResource SuccessLightBrush}"
                                CornerRadius="10"
                                Padding="18,12"
                                VerticalAlignment="Center"
                                MinWidth="160"
                                Margin="16,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="PPV TTC"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource SuccessDarkBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding FormattedPrice}"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessDarkBrush}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════
                     THREE-COLUMN CONTENT
                ══════════════════════════════════════════ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═══ COLUMN 1: Tarification + Composition ═══ -->
                    <StackPanel Grid.Column="0">

                        <!-- TARIFICATION -->
                        <Border Style="{StaticResource DetailCardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionHeaderPanel}">
                                    <materialDesign:PackIcon Kind="CurrencyUsd" Width="20" Height="20"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="Tarification"
                                               Style="{StaticResource TitleH3Style}"
                                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="PRIX FAB. HT" Style="{StaticResource DetailLabelStyle}"/>
                                        <TextBlock Text="{Binding FormattedRefPrice}" Style="{StaticResource DetailValueStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="PRIX HOSPITALIER" Style="{StaticResource DetailLabelStyle}"/>
                                        <TextBlock Text="{Binding FormattedPctPrice}" Style="{StaticResource DetailValueStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="PRIX DE GROS" Style="{StaticResource DetailLabelStyle}"/>
                                        <TextBlock Text="{Binding FormattedNetPrice}" Style="{StaticResource DetailValueStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="TIMBRE" Style="{StaticResource DetailLabelStyle}"/>
                                        <TextBlock Text="{Binding FormattedTimbre}" Style="{StaticResource DetailValueStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="BASE REMB." Style="{StaticResource DetailLabelStyle}"/>
                                        <TextBlock Text="{Binding FormattedPamount}" Style="{StaticResource DetailValueStyle}" Margin="0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="TAUX REMB." Style="{StaticResource DetailLabelStyle}"/>
                                        <TextBlock Style="{StaticResource DetailValueStyle}" Margin="0">
                                            <Run Text="{Binding Medic.ictx, Mode=OneWay, StringFormat={}{0}%}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- COMPOSITION (DCI) -->
                        <Border Style="{StaticResource DetailCardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionHeaderPanel}">
                                    <materialDesign:PackIcon Kind="Flask" Width="20" Height="20"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="Composition (DCI)"
                                               Style="{StaticResource TitleH3Style}"
                                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- DCI 1 -->
                                <Border Background="{StaticResource BorderLightBrush}"
                                        CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="DCI PRINCIPAL"
                                                       FontSize="9.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       Margin="0,0,0,1"/>
                                            <TextBlock Text="{Binding Medic.dci1, TargetNullValue='-'}"
                                                       FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Medic.dose1, TargetNullValue=''}"
                                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text=" " FontSize="12.5"/>
                                            <TextBlock Text="{Binding Medic.u1, TargetNullValue=''}"
                                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- DCI 2 -->
                                <Border Background="{StaticResource BorderLightBrush}"
                                        CornerRadius="6" Padding="10,8" Margin="0,0,0,6"
                                        Visibility="{Binding HasDci2, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="DCI SECONDAIRE"
                                                       FontSize="9.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,0,0,1"/>
                                            <TextBlock Text="{Binding Medic.dci2}" FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Medic.dose2, TargetNullValue=''}"
                                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text=" " FontSize="12.5"/>
                                            <TextBlock Text="{Binding Medic.u2, TargetNullValue=''}"
                                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- DCI 3 -->
                                <Border Background="{StaticResource BorderLightBrush}"
                                        CornerRadius="6" Padding="10,8" Margin="0,0,0,6"
                                        Visibility="{Binding HasDci3, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="DCI 3"
                                                       FontSize="9.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,0,0,1"/>
                                            <TextBlock Text="{Binding Medic.dci3}" FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Medic.dose3, TargetNullValue=''}"
                                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text=" " FontSize="12.5"/>
                                            <TextBlock Text="{Binding Medic.u3, TargetNullValue=''}"
                                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- DCI 4 -->
                                <Border Background="{StaticResource BorderLightBrush}"
                                        CornerRadius="6" Padding="10,8"
                                        Visibility="{Binding HasDci4, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="DCI 4"
                                                       FontSize="9.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,0,0,1"/>
                                            <TextBlock Text="{Binding Medic.dci4}" FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Medic.dose4, TargetNullValue=''}"
                                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text=" " FontSize="12.5"/>
                                            <TextBlock Text="{Binding Medic.u4, TargetNullValue=''}"
                                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- CONDUITE ET VIGILANCE -->
                        <Border Style="{StaticResource DetailCardStyle}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionHeaderPanel}">
                                    <materialDesign:PackIcon Kind="Car" Width="20" Height="20"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="Conduite et vigilance"
                                               Style="{StaticResource TitleH3Style}"
                                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Border Background="{StaticResource BorderLightBrush}"
                                        CornerRadius="6" Padding="10,8">
                                    <TextBlock Text="{Binding VeicDescription}"
                                               FontSize="13" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══ COLUMN 2: Identification + Classification ═══ -->
                    <StackPanel Grid.Column="2">

                        <!-- IDENTIFICATION -->
                        <Border Style="{StaticResource DetailCardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionHeaderPanel}">
                                    <materialDesign:PackIcon Kind="CardAccountDetails" Width="20" Height="20"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="Identification"
                                               Style="{StaticResource TitleH3Style}"
                                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="CODE-BARRE" Style="{StaticResource DetailLabelStyle}"/>
                                        <TextBlock Text="{Binding Medic.barcode, TargetNullValue='-'}"
                                                   Style="{StaticResource DetailValueStyle}" FontFamily="Consolas"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="N° AMM" Style="{StaticResource DetailLabelStyle}"/>
                                        <TextBlock Text="{Binding Medic.amm, TargetNullValue='-'}"
                                                   Style="{StaticResource DetailValueStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="CODE PCT" Style="{StaticResource DetailLabelStyle}"/>
                                        <TextBlock Text="{Binding Medic.pctcode, TargetNullValue='-'}"
                                                   Style="{StaticResource DetailValueStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="COLISAGE" Style="{StaticResource DetailLabelStyle}"/>
                                        <TextBlock Style="{StaticResource DetailValueStyle}">
                                            <Run Text="{Binding Medic.colisage, Mode=OneWay}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Medic.ucol, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="AJOUTÉ LE" Style="{StaticResource DetailLabelStyle}"/>
                                        <TextBlock Text="{Binding FormattedAddedDate}"
                                                   Style="{StaticResource DetailValueStyle}" Margin="0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="MIS À JOUR" Style="{StaticResource DetailLabelStyle}"/>
                                        <TextBlock Text="{Binding FormattedUpdatedDate}"
                                                   Style="{StaticResource DetailValueStyle}" Margin="0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CLASSIFICATION -->
                        <Border Style="{StaticResource DetailCardStyle}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionHeaderPanel}">
                                    <materialDesign:PackIcon Kind="FolderMultiple" Width="20" Height="20"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="Classification"
                                               Style="{StaticResource TitleH3Style}"
                                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="FAMILLE 1" Style="{StaticResource DetailLabelStyle}"/>
                                        <TextBlock Text="{Binding Medic.fam1, TargetNullValue='-'}"
                                                   Style="{StaticResource DetailValueStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="FAMILLE 2" Style="{StaticResource DetailLabelStyle}"/>
                                        <TextBlock Text="{Binding Medic.fam2, TargetNullValue='-'}"
                                                   Style="{StaticResource DetailValueStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="FAMILLE 3" Style="{StaticResource DetailLabelStyle}"/>
                                        <TextBlock Text="{Binding Medic.fam3, TargetNullValue='-'}"
                                                   Style="{StaticResource DetailValueStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="FAMILLE PRINCIPALE" Style="{StaticResource DetailLabelStyle}"/>
                                        <TextBlock Text="{Binding Medic.family, TargetNullValue='-'}"
                                                   Style="{StaticResource DetailValueStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                Visibility="{Binding HasSpecialite, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="SPÉCIALITÉ" Style="{StaticResource DetailLabelStyle}"/>
                                        <TextBlock Text="{Binding Medic.specialite}"
                                                   Style="{StaticResource DetailValueStyle}" Margin="0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══ COLUMN 3: Posology + Notes ═══ -->
                    <StackPanel Grid.Column="4">

                        <!-- POSOLOGIE -->
                        <Border Style="{StaticResource DetailCardStyle}" Margin="0,0,0,10"
                                Visibility="{Binding HasPosology, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionHeaderPanel}">
                                    <materialDesign:PackIcon Kind="MedicalBag" Width="20" Height="20"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="Posologie"
                                               Style="{StaticResource TitleH3Style}"
                                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Border Background="{StaticResource BorderLightBrush}"
                                        CornerRadius="6" Padding="12,10">
                                    <TextBlock Text="{Binding Medic.posology}"
                                               TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- MONOGRAPHIE (aperçu Markdown) -->
                        <Border Style="{StaticResource DetailCardStyle}" Margin="0,0,0,10"
                                Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionHeaderPanel}">
                                    <materialDesign:PackIcon Kind="BookOpenPageVariant" Width="20" Height="20"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="Monographie"
                                               Style="{StaticResource TitleH3Style}"
                                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Border Background="{StaticResource BorderLightBrush}"
                                        CornerRadius="6" Padding="12,10">
                                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding Medic.monographie}"
                                                   TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                                   FontFamily="Consolas, Cascadia Mono, Courier New"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- DÉNOMINATION -->
                        <Border Style="{StaticResource DetailCardStyle}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionHeaderPanel}">
                                    <materialDesign:PackIcon Kind="Label" Width="20" Height="20"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="Dénomination"
                                               Style="{StaticResource TitleH3Style}"
                                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="NOM COMPLET" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding Medic.itemname, TargetNullValue='-'}"
                                               Style="{StaticResource DetailValueStyle}" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="NOM COURT" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding Medic.shortname, TargetNullValue='-'}"
                                               Style="{StaticResource DetailValueStyle}"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="NOM DE BASE" Style="{StaticResource DetailLabelStyle}"/>
                                    <TextBlock Text="{Binding Medic.basename, TargetNullValue='-'}"
                                               Style="{StaticResource DetailValueStyle}" Margin="0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading overlay -->
        <Border Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Style="{StaticResource MaterialDesignCircularProgressBar}"/>
                <TextBlock Text="Chargement de la fiche..."
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
