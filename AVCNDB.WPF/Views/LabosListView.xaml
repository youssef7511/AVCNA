<UserControl x:Class="AVCNDB.WPF.Views.LabosListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AVCNDB.WPF.ViewModels"
             xmlns:helpers="clr-namespace:AVCNDB.WPF.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LabosListViewModel}"
             Background="{DynamicResource MaterialDesignBackground}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barre d'outils -->
        <Border Grid.Row="0" 
                Background="{DynamicResource MaterialDesignPaper}"
                Padding="10,6"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Recherche -->
                <TextBox materialDesign:TextFieldAssist.HasClearButton="True" Grid.Column="0"
                         Width="280"
                         Height="36"
                         Padding="10,6"
                         VerticalContentAlignment="Center"
                         FontSize="13"
                         HorizontalAlignment="Left"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Rechercher un laboratoire..."
                         materialDesign:HintAssist.IsFloating="False"
                         materialDesign:TextFieldAssist.DecorationVisibility="Visible"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding ApplySubstitutsCommand}"
                            Style="{StaticResource TabToolbarPrimaryButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="Remplacer les dénominations par les substituts dans Labos et Médicaments">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SwapHorizontalBold" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Appliquer les substituts" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AddNewCommand}"
                            Style="{StaticResource TabToolbarPrimaryButtonStyle}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Nouveau laboratoire" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ImportFromExcelCommand}"
                            Style="{StaticResource TabToolbarSecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="Importer depuis Excel (template strict)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="MicrosoftExcel" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Import" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DownloadExcelTemplateCommand}"
                            Style="{StaticResource TabToolbarSecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="Télécharger le modèle Excel (template strict)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Modèle" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportCommand}"
                            Style="{StaticResource TabToolbarSecondaryButtonStyle}"
                            ToolTip="Exporter en Excel">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Download" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Export" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Liste des laboratoires -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Labos}"
                  SelectedItem="{Binding SelectedLabo}"
                  Style="{StaticResource ModernDataGridStyle}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  Margin="0,4,0,0">

            <DataGrid.Resources>
                <helpers:BindingProxy x:Key="vmProxy" Data="{Binding}"/>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <!-- Sélection -->
                <DataGridTemplateColumn Width="45" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="recordid" Visibility="Collapsed" 
                                    Binding="{Binding recordid}" 
                                    Width="80"
                                    IsReadOnly="True"/>
                
                <DataGridTextColumn Header="Dénomination" 
                                    Binding="{Binding itemname}" 
                                    Width="1.6*"/>

                <DataGridTextColumn Header="Substitut" 
                                    Binding="{Binding subvalue}" 
                                    Width="1*"/>

                <DataGridTextColumn Header="addedat" Visibility="Collapsed"
                                    Binding="{Binding addedat, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                    Width="170"/>

                <DataGridTextColumn Header="updatedat" Visibility="Collapsed"
                                    Binding="{Binding updatedat, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                    Width="170"/>

                <!-- Actions (⋮ menu) -->
                <DataGridTemplateColumn Header="" Width="50" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges"
                                                     StaysOpen="False" ToolTip="Actions" Padding="0"
                                                     HorizontalAlignment="Center">
                                <materialDesign:PopupBox.ToggleContent>
                                    <materialDesign:PackIcon Kind="DotsVertical" Width="20" Height="20"
                                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                                </materialDesign:PopupBox.ToggleContent>
                                <StackPanel MinWidth="160">
                                    <Button Command="{Binding Data.EditCommand, Source={StaticResource vmProxy}}"
                                            CommandParameter="{Binding}"
                                            HorizontalContentAlignment="Left" Padding="16,10">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                                            <TextBlock Text="Modifier" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding Data.DeleteCommand, Source={StaticResource vmProxy}}"
                                            CommandParameter="{Binding}"
                                            HorizontalContentAlignment="Left" Padding="16,10">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource ErrorBrush}"/>
                                            <TextBlock Text="Supprimer" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </materialDesign:PopupBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Indicateur de chargement -->
        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                     VerticalAlignment="Top"
                     Margin="0"/>

        <!-- Édition / Ajout -->
        <Border Grid.RowSpan="2"
                Background="#80000000"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource MaterialDesignPaper}"
                    CornerRadius="8"
                    Padding="24"
                    MaxWidth="900"
                    MinWidth="760"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Margin="0,0,0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TabDialogTitleStyle}">
                                <Setter Property="Text" Value="Édition Laboratoire"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedLabo}" Value="{x:Null}">
                                        <Setter Property="Text" Value="Nouveau laboratoire"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBox materialDesign:TextFieldAssist.HasClearButton="True" Text="{Binding EditItemName, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Nom *"
                             Style="{StaticResource DialogLineTextBoxStyle}"
                             Margin="0,0,0,12" />

                    <TextBox materialDesign:TextFieldAssist.HasClearButton="True" Text="{Binding EditSubValue, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Substitut"
                             Style="{StaticResource DialogLineTextBoxStyle}"
                             Visibility="{Binding SelectedLabo, Converter={StaticResource NullToVisibility}}"
                             Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CancelEditCommand}"
                                Style="{StaticResource TabDialogSecondaryButtonStyle}"
                                Margin="0,0,12,0">
                            Annuler
                        </Button>
                        <Button Command="{Binding SaveCommand}"
                                Style="{StaticResource TabDialogPrimaryButtonStyle}">
                            Enregistrer
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>





