<UserControl x:Class="AVCNDB.WPF.Views.PosoListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AVCNDB.WPF.ViewModels"
             xmlns:helpers="clr-namespace:AVCNDB.WPF.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PosoListViewModel}"
             Background="{DynamicResource MaterialDesignBackground}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource MaterialDesignPaper}"
                Padding="10,6"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox materialDesign:TextFieldAssist.HasClearButton="True" Grid.Column="0"
                         Width="280"
                         Height="36"
                         Padding="10,6"
                         VerticalContentAlignment="Center"
                         FontSize="13"
                         HorizontalAlignment="Left"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Rechercher une posologie..."
                         materialDesign:HintAssist.IsFloating="False"
                         materialDesign:TextFieldAssist.DecorationVisibility="Visible"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding ApplySubstitutsCommand}"
                            Style="{StaticResource TabToolbarPrimaryButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="Remplacer les dénominations par les substituts dans Posologies">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SwapHorizontalBold" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Appliquer les substituts" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AddNewCommand}"
                            Style="{StaticResource TabToolbarPrimaryButtonStyle}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Nouvelle posologie" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ImportFromExcelCommand}"
                            Style="{StaticResource TabToolbarSecondaryButtonStyle}"
                            Margin="8,0,0,0"
                            ToolTip="Importer depuis Excel (template strict)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="MicrosoftExcel" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Import" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DownloadExcelTemplateCommand}"
                            Style="{StaticResource TabToolbarSecondaryButtonStyle}"
                            Margin="8,0,0,0"
                            ToolTip="Telecharger le modele Excel (template strict)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Modele" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportCommand}"
                            Style="{StaticResource TabToolbarSecondaryButtonStyle}"
                            Margin="8,0,0,0"
                            ToolTip="Exporter en Excel">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Download" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Export" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Posos}"
                  SelectedItem="{Binding SelectedPoso}"
                  Style="{StaticResource ModernDataGridStyle}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  Margin="0,4,0,0">

            <DataGrid.Resources>
                <helpers:BindingProxy x:Key="vmProxy" Data="{Binding}"/>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTemplateColumn Width="45" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="recordid" Visibility="Collapsed" Binding="{Binding recordid}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Dénomination" Binding="{Binding itemname}" Width="170"/>
                <DataGridTextColumn Header="Quantité" Binding="{Binding qty}" Width="100"/>
                <DataGridTextColumn Header="Forme poso" Binding="{Binding posoform}" Width="140"/>
                <DataGridTextColumn Header="Prises" Binding="{Binding prises}" Width="100"/>
                <DataGridTextColumn Header="Période" Binding="{Binding periode}" Width="130"/>
                <DataGridTextColumn Header="Conditions" Binding="{Binding conditions}" Width="190"/>
                <DataGridTextColumn Header="Nom formule" Binding="{Binding nameformul}" Width="170"/>
                <DataGridTextColumn Header="Substitut" Binding="{Binding subvalue}" Width="170"/>
                <DataGridTextColumn Header="addedat" Visibility="Collapsed" Binding="{Binding addedat, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="170"/>
                <DataGridTextColumn Header="updatedat" Visibility="Collapsed" Binding="{Binding updatedat, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="170"/>

                <DataGridTemplateColumn Header="" Width="50" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges"
                                                     StaysOpen="False" ToolTip="Actions" Padding="0"
                                                     HorizontalAlignment="Center">
                                <materialDesign:PopupBox.ToggleContent>
                                    <materialDesign:PackIcon Kind="DotsVertical" Width="20" Height="20"
                                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                                </materialDesign:PopupBox.ToggleContent>
                                <StackPanel MinWidth="160">
                                    <Button Command="{Binding Data.EditCommand, Source={StaticResource vmProxy}}"
                                            CommandParameter="{Binding}"
                                            HorizontalContentAlignment="Left" Padding="16,10">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                                            <TextBlock Text="Modifier" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding Data.DeleteCommand, Source={StaticResource vmProxy}}"
                                            CommandParameter="{Binding}"
                                            HorizontalContentAlignment="Left" Padding="16,10">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource ErrorBrush}"/>
                                            <TextBlock Text="Supprimer" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </materialDesign:PopupBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                     VerticalAlignment="Top"
                     Margin="0"/>

        <Border Grid.RowSpan="2"
                Background="#80000000"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource MaterialDesignPaper}"
                    CornerRadius="8"
                    Padding="24"
                    MaxWidth="900"
                    MinWidth="760"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="680">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TabDialogTitleStyle}">
                                    <Setter Property="Text" Value="Edition posologie"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPoso}" Value="{x:Null}">
                                            <Setter Property="Text" Value="Nouvelle posologie"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox materialDesign:TextFieldAssist.HasClearButton="True" Text="{Binding EditItemName, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Nom *"
                                 Style="{StaticResource DialogLineTextBoxStyle}"
                                 Margin="0,0,0,12"/>

                        <TextBox materialDesign:TextFieldAssist.HasClearButton="True" Text="{Binding EditQty, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Quantite"
                                 Style="{StaticResource DialogLineTextBoxStyle}"
                                 Margin="0,0,0,12"/>

                        <TextBox materialDesign:TextFieldAssist.HasClearButton="True" Text="{Binding EditPosoForm, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Forme poso"
                                 Style="{StaticResource DialogLineTextBoxStyle}"
                                 Margin="0,0,0,12"/>

                        <TextBox materialDesign:TextFieldAssist.HasClearButton="True" Text="{Binding EditPrises, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Prises"
                                 Style="{StaticResource DialogLineTextBoxStyle}"
                                 Margin="0,0,0,12"/>

                        <TextBox materialDesign:TextFieldAssist.HasClearButton="True" Text="{Binding EditPeriode, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Periode"
                                 Style="{StaticResource DialogLineTextBoxStyle}"
                                 Margin="0,0,0,12"/>

                        <TextBox materialDesign:TextFieldAssist.HasClearButton="True" Text="{Binding EditConditions, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Conditions"
                                 Style="{StaticResource DialogLineTextBoxStyle}"
                                 Margin="0,0,0,12"/>

                        <TextBox materialDesign:TextFieldAssist.HasClearButton="True" Text="{Binding EditNameFormul, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Nom formule"
                                 Style="{StaticResource DialogLineTextBoxStyle}"
                                 Margin="0,0,0,12"/>

                        <TextBox materialDesign:TextFieldAssist.HasClearButton="True" Text="{Binding EditSubValue, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Substitut"
                                 Style="{StaticResource DialogLineTextBoxStyle}"
                                 Visibility="{Binding SelectedPoso, Converter={StaticResource NullToVisibility}}"
                                 Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding CancelEditCommand}"
                                    Style="{StaticResource TabDialogSecondaryButtonStyle}"
                                    Margin="0,0,12,0">Annuler</Button>
                            <Button Command="{Binding SaveCommand}"
                                    Style="{StaticResource TabDialogPrimaryButtonStyle}">Enregistrer</Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</UserControl>



