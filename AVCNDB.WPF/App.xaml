<Application x:Class="AVCNDB.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AVCNDB.WPF.Converters"
             xmlns:vm="clr-namespace:AVCNDB.WPF.ViewModels"
             xmlns:views="clr-namespace:AVCNDB.WPF.Views">
    
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Material Design -->
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Blue" SecondaryColor="Teal" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                
                <!-- Application Styles -->
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/ButtonStyles.xaml" />
                <ResourceDictionary Source="Styles/DataGridStyles.xaml" />
                <ResourceDictionary Source="Styles/TextStyles.xaml" />
                <ResourceDictionary Source="Styles/CardStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:IntToBoolConverter x:Key="IntToBoolConverter"/>
            <converters:StringNotNullOrEmptyToVisibilityConverter x:Key="StringNotNullOrEmptyToVisibility"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibility"/>
            <converters:RatioToHeightConverter x:Key="RatioToHeight"/>
            <converters:PercentageToArcGeometryConverter x:Key="PercentArcConverter"/>
            <converters:MonthsToPolylineConverter x:Key="MonthsToPolyline"/>

            <!-- ============================================
                 OVERRIDES MATERIAL DESIGN
                 Re-pointe les surfaces / textes / ombres de la
                 librairie Material vers la palette « Apothecary »
                 pour que toute la fenêtre adopte le parchemin.
            ============================================ -->
            <SolidColorBrush x:Key="MaterialDesignBackground"     Color="{StaticResource PaperColor}"/>
            <SolidColorBrush x:Key="MaterialDesignPaper"          Color="{StaticResource BoneColor}"/>
            <SolidColorBrush x:Key="MaterialDesignCardBackground" Color="{StaticResource BoneColor}"/>
            <SolidColorBrush x:Key="MaterialDesignBody"           Color="{StaticResource InkColor}"/>
            <SolidColorBrush x:Key="MaterialDesignBodyLight"      Color="{StaticResource InkSoftColor}"/>
            <SolidColorBrush x:Key="MaterialDesignDivider"        Color="{StaticResource BorderColor}"/>
            <SolidColorBrush x:Key="MaterialDesignToolForeground" Color="{StaticResource InkSoftColor}"/>
            <SolidColorBrush x:Key="MaterialDesignToolBackground" Color="{StaticResource BoneColor}"/>
            <SolidColorBrush x:Key="MaterialDesignSelection"      Color="{StaticResource BotanicalLightColor}"/>

            <!-- Material Design : palette primaire / secondaire (utilisée par
                 MaterialDesignRaisedButton, OutlinedButton, FloatingHint…) -->
            <SolidColorBrush x:Key="PrimaryHueLightBrush"           Color="{StaticResource BotanicalLightColor}"/>
            <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="{StaticResource InkColor}"/>
            <SolidColorBrush x:Key="PrimaryHueMidBrush"             Color="{StaticResource BotanicalColor}"/>
            <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush"   Color="{StaticResource BoneColor}"/>
            <SolidColorBrush x:Key="PrimaryHueDarkBrush"            Color="{StaticResource BotanicalDarkColor}"/>
            <SolidColorBrush x:Key="PrimaryHueDarkForegroundBrush"  Color="{StaticResource BoneColor}"/>

            <SolidColorBrush x:Key="SecondaryHueLightBrush"           Color="{StaticResource OchreLightColor}"/>
            <SolidColorBrush x:Key="SecondaryHueLightForegroundBrush" Color="{StaticResource InkColor}"/>
            <SolidColorBrush x:Key="SecondaryHueMidBrush"             Color="{StaticResource OchreColor}"/>
            <SolidColorBrush x:Key="SecondaryHueMidForegroundBrush"   Color="{StaticResource BoneColor}"/>
            <SolidColorBrush x:Key="SecondaryHueDarkBrush"            Color="{StaticResource OchreDarkColor}"/>
            <SolidColorBrush x:Key="SecondaryHueDarkForegroundBrush"  Color="{StaticResource BoneColor}"/>

            <SolidColorBrush x:Key="SecondaryAccentBrush"             Color="{StaticResource OchreColor}"/>
            <SolidColorBrush x:Key="SecondaryAccentForegroundBrush"   Color="{StaticResource BoneColor}"/>

            <SolidColorBrush x:Key="ValidationErrorBrush"             Color="{StaticResource VermillionColor}"/>
            <SolidColorBrush x:Key="MaterialDesignValidationErrorBrush" Color="{StaticResource VermillionColor}"/>
            <SolidColorBrush x:Key="MaterialDesignFlatButtonClick"    Color="{StaticResource BotanicalLightColor}"/>

            <!-- Police par défaut globale -->
            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
                <Setter Property="Background"  Value="{StaticResource PaperBrush}"/>
            </Style>

            <!-- Fallbacks for MaterialDesign resource keys (avoid runtime StaticResource crashes) -->
            <Style x:Key="MaterialDesignHeadline4TextBlock" TargetType="TextBlock" BasedOn="{StaticResource TitleH2Style}" />
            <Style x:Key="MaterialDesignBody2TextBlock" TargetType="TextBlock" BasedOn="{StaticResource SubtitleStyle}" />
            <Style x:Key="MaterialDesignFilledTabControl" TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}" />

            <!-- Harmonized line-style inputs for Add/Edit dialogs -->
            <Style x:Key="DialogLineTextBoxStyle"
                   TargetType="TextBox"
                   BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
                <Setter Property="MinHeight" Value="42"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
                <Setter Property="materialDesign:TextFieldAssist.HasClearButton" Value="True"/>
            </Style>

            <Style x:Key="DialogLineComboBoxStyle"
                   TargetType="ComboBox"
                   BasedOn="{StaticResource MaterialDesignFloatingHintComboBox}">
                <Setter Property="MinHeight" Value="42"/>
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
            </Style>

            <!-- ViewModel to View DataTemplates -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:MedicListViewModel}">
                <views:MedicListView />
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:MedicDetailViewModel}">
                <views:MedicDetailView />
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:MedicEditViewModel}">
                <views:MedicEditView />
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:DciListViewModel}">
                <views:DciListView />
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:FamiliesListViewModel}">
                <views:FamiliesListView />
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:LabosListViewModel}">
                <views:LabosListView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SpecialitesListViewModel}">
                <views:SpecialitesListView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PresentsListViewModel}">
                <views:PresentsListView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PosoListViewModel}">
                <views:PosoListView />
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:InteractionsViewModel}">
                <views:InteractionsView />
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:StockViewModel}">
                <views:StockView />
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DatabaseViewModel}">
                <views:DatabaseView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:LibraryShellViewModel}">
                <views:LibraryView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ToolsViewModel}">
                <views:ToolsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:EditionFileViewModel}">
                <views:MovementsView />
            </DataTemplate>
            
        </ResourceDictionary>
    </Application.Resources>
    
</Application>
